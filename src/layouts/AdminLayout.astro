---
import '../styles/global.css';
import Icon from '../components/admin/Icon.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { roleLabel } from '../lib/auth';
import { getSettings } from '../lib/settings';
import { buildThemeCss } from '../lib/theme';
import { buildFontCss, getPreloadFont } from '../lib/fonts';

interface Props {
  title?: string;
  active?: string;
  wide?: boolean;
}

const { title = 'Dashboard', active = '', wide = false } = Astro.props;
const user = Astro.locals.user;
const settings = await getSettings();
const themeCss = buildThemeCss(settings.themeColor);
const fontCss = buildFontCss(settings.fontFamily, settings.fontHeading, settings.fontSize);
const preloadFont = getPreloadFont(settings.fontFamily);

const nav = [
  { href: '/admin', label: 'Dashboard', icon: 'dashboard', key: 'dashboard' },
  { href: '/admin/posts', label: 'Post', icon: 'posts', key: 'posts' },
  { href: '/admin/pages', label: 'Halaman', icon: 'pages', key: 'pages' },
  { href: '/admin/categories', label: 'Kategori', icon: 'categories', key: 'categories' },
  { href: '/admin/tags', label: 'Tag', icon: 'tags', key: 'tags' },
  { href: '/admin/menus', label: 'Menu', icon: 'menu', key: 'menus' },
  { href: '/admin/media', label: 'Media', icon: 'media', key: 'media' },
  { href: '/admin/ads', label: 'Iklan', icon: 'chart', key: 'ads' },
  { href: '/admin/comments', label: 'Komentar', icon: 'comments', key: 'comments' },
  { href: '/admin/users', label: 'Pengguna', icon: 'users', key: 'users' },
  { href: '/admin/customize', label: 'Kode Custom', icon: 'code', key: 'customize' },
  { href: '/admin/settings', label: 'Pengaturan', icon: 'settings', key: 'settings' },
];
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Admin {settings.siteName}</title>
    <link rel="icon" href={settings.favicon || '/favicon.svg'} />
    <style is:global set:html={themeCss}></style>
    {preloadFont && <link rel="preload" href={preloadFont} as="font" type="font/woff2" crossorigin />}
    <link rel="stylesheet" href="/fonts/fonts.css" />
    <style is:global set:html={fontCss}></style>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('nomina-theme') || 'system';
          var dark =
            t === 'dark' ||
            (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>
    {settings.customAdminCss?.trim() && <style is:global set:html={settings.customAdminCss} />}
  </head>
  <body class="bg-ink-50 text-ink-800 antialiased">
    <div class="flex min-h-screen">
      <aside class="sticky top-0 hidden h-screen w-64 shrink-0 flex-col overflow-hidden bg-night-900 text-night-fg lg:flex">
        <div class="blob blob-brand -left-16 -top-16 h-56 w-56 opacity-30"></div>
        <div class="blob blob-grape right-0 bottom-24 h-48 w-48 opacity-25"></div>

        <a href="/admin" class="relative z-10 flex items-center gap-2.5 px-5 py-5">
          <span class="flex h-10 w-10 items-center justify-center rounded-2xl bg-brand-400 font-black text-brand-ink shadow-pop">
            {settings.siteName.charAt(0)}
          </span>
          <span>
            <span class="block font-display text-lg font-extrabold leading-tight text-white">
              {settings.siteName}
            </span>
            <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-brand-400">Panel Redaksi</span>
          </span>
        </a>

        <nav class="relative z-10 flex-1 space-y-1 overflow-y-auto p-3 text-sm">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class={`group flex items-center gap-3 rounded-2xl px-3 py-2.5 font-semibold transition ${
                  active === item.key
                    ? 'bg-white/10 text-white shadow-soft'
                    : 'text-night-fg-muted hover:bg-white/5 hover:text-white'
                }`}
              >
                <span
                  class={`flex h-8 w-8 items-center justify-center rounded-xl bg-gradient-to-br from-brand-300 to-brand-500 text-brand-ink transition group-hover:scale-110`}
                >
                  <Icon name={item.icon} class="h-4 w-4" />
                </span>
                {item.label}
                {active === item.key && <span class="ml-auto h-1.5 w-1.5 rounded-full bg-brand-400" />}
              </a>
            ))
          }
        </nav>

        <div class="relative z-10 border-t border-white/10 p-4 text-xs">
          <a
            href="/"
            target="_blank"
            class="flex items-center gap-2 rounded-xl px-2 py-2 font-semibold text-night-fg transition hover:bg-white/5 hover:text-white"
          >
            <Icon name="external" class="h-4 w-4" /> Lihat Situs
          </a>
          <form method="post" action="/api/logout">
            <button
              type="submit"
              class="flex w-full items-center gap-2 rounded-xl px-2 py-2 font-semibold text-night-fg transition hover:bg-brand-400/20 hover:text-brand-300"
            >
              <Icon name="logout" class="h-4 w-4" /> Keluar
            </button>
          </form>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-20 flex items-center justify-between gap-4 border-b border-ink-100 bg-surface/80 px-5 py-3 backdrop-blur-xl">
          <h1 class="font-display text-lg font-extrabold text-ink-900">{title}</h1>

          <div class="flex items-center gap-3">
            <form action="/admin/posts" method="get" class="hidden sm:block">
              <input
                type="search"
                name="q"
                placeholder="Cari post…"
                class="w-48 rounded-full border border-ink-200 bg-ink-50 px-4 py-2 text-sm outline-none transition focus:border-brand-400 focus:bg-surface focus:ring-4 focus:ring-brand-100"
              />
            </form>
            <ThemeToggle class="h-9 w-9" />
            <div class="flex items-center gap-2.5 rounded-full border border-ink-200 bg-surface py-1 pr-4 pl-1">
              <span class="flex h-8 w-8 items-center justify-center overflow-hidden rounded-full bg-brand-400 text-xs font-bold text-brand-ink">
                {
                  user?.avatar ? (
                    <img src={user.avatar} alt={user.name} width={36} height={36} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  ) : (
                    user?.name?.charAt(0) ?? '?'
                  )
                }
              </span>
              <div class="hidden leading-tight sm:block">
                <p class="text-sm font-bold text-ink-900">{user?.name}</p>
                <p class="text-[11px] font-semibold text-brand-600">{user ? roleLabel[user.role] : ''}</p>
              </div>
            </div>
          </div>
        </header>

        <main class={`flex-1 p-5 ${wide ? '' : 'mx-auto w-full max-w-6xl'}`}>
          <slot />
        </main>

        <footer class="border-t border-ink-100 bg-surface px-5 py-4 text-center text-xs text-ink-400">
          Panel Admin {settings.siteName} — Astro.js + PostgreSQL
        </footer>
      </div>
    </div>

    <script is:inline>
      document.addEventListener('click', function (e) {
        const btn = e.target.closest('[data-confirm]');
        if (btn && !confirm(btn.getAttribute('data-confirm'))) {
          e.preventDefault();
        }
      });
    </script>
    <script is:inline>
      /* color picker: sinkronkan input native, input teks, dan palet */
      (function () {
        if (window.__nominaColorField) return;
        window.__nominaColorField = true;

        document.addEventListener('input', function (e) {
          const native = e.target.closest('[data-color-native]');
          if (native) {
            const wrap = native.closest('[data-color-field]');
            const text = wrap && wrap.querySelector('[data-color-text]');
            if (text) text.value = native.value;
            return;
          }

          const text = e.target.closest('[data-color-text]');
          if (text && /^#[0-9a-fA-F]{6}$/.test(text.value)) {
            const wrap = text.closest('[data-color-field]');
            const n = wrap && wrap.querySelector('[data-color-native]');
            if (n) n.value = text.value;
          }
        });

        document.addEventListener('click', function (e) {
          const preset = e.target.closest('[data-color-preset]');
          if (!preset) return;
          const wrap = preset.closest('[data-color-field]');
          const value = preset.getAttribute('data-color-preset');
          const native = wrap && wrap.querySelector('[data-color-native]');
          const text = wrap && wrap.querySelector('[data-color-text]');
          if (native) native.value = value;
          if (text) text.value = value;
        });
      })();
    </script>
    {settings.customAdminJs?.trim() && <script is:inline set:html={settings.customAdminJs} />}
  </body>
</html>
