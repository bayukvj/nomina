---
import type { ViewsPoint } from '../../lib/content';

interface Props {
  series: ViewsPoint[];
  height?: number;
  label?: string;
}

const { series, height = 200, label = '' } = Astro.props;

const max = Math.max(...series.map((s) => s.count), 1);
const total = series.reduce((sum, s) => sum + s.count, 0);
const barGap = 2;
const chartWidth = 1000;
const barWidth = Math.max(2, chartWidth / series.length - barGap);

const monthNames = [
  'Jan',
  'Feb',
  'Mar',
  'Apr',
  'Mei',
  'Jun',
  'Jul',
  'Agu',
  'Sep',
  'Okt',
  'Nov',
  'Des',
];

const fmt = (n: number) => new Intl.NumberFormat('id-ID').format(n);

/* label sumbu X: tampilkan sekitar 6 titik */
const labelStep = Math.max(1, Math.ceil(series.length / 6));
---

<div class="space-y-3">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <p class="text-xs font-bold uppercase tracking-wider text-ink-500">Total tayangan {label}</p>
      <p class="font-display text-3xl font-extrabold text-ink-900">{fmt(total)}</p>
    </div>
    <p class="text-xs text-ink-500">
      Rata-rata <span class="font-bold text-ink-800">{fmt(Math.round(total / Math.max(series.length, 1)))}</span>
      / hari · puncak <span class="font-bold text-ink-800">{fmt(max)}</span>
    </p>
  </div>

  <div class="relative w-full overflow-hidden">
    <svg
      viewBox={`0 0 ${chartWidth} ${height + 26}`}
      class="w-full"
      role="img"
      aria-label="Grafik tayangan harian"
      preserveAspectRatio="none"
    >
      <defs>
        <linearGradient id="chartBar" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--color-brand-300)"></stop>
          <stop offset="100%" stop-color="var(--color-brand-500)"></stop>
        </linearGradient>
        <linearGradient id="chartArea" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="var(--color-brand-400)" stop-opacity="0.35"></stop>
          <stop offset="100%" stop-color="var(--color-brand-400)" stop-opacity="0"></stop>
        </linearGradient>
      </defs>

      {/* garis bantu */}
      {[0.25, 0.5, 0.75].map((r) => (
        <line
          x1="0"
          x2={chartWidth}
          y1={height * r}
          y2={height * r}
          stroke="currentColor"
          stroke-opacity="0.08"
          stroke-width="1"
        />
      ))}

      {/* area + batang */}
      {
        series.map((s, i) => {
          const h = (s.count / max) * (height - 8);
          const x = i * (barWidth + barGap);
          const y = height - h;
          return (
            <g>
              <title>
                {s.day}: {fmt(s.count)} tayangan
              </title>
              <rect
                x={x}
                y={y}
                width={barWidth}
                height={Math.max(h, 1)}
                rx={Math.min(barWidth / 2, 4)}
                fill="url(#chartBar)"
              />
            </g>
          );
        })
      }

      {/* label sumbu X */}
      {
        series.map((s, i) =>
          i % labelStep === 0 || i === series.length - 1 ? (
            <text
              x={i * (barWidth + barGap) + barWidth / 2}
              y={height + 18}
              text-anchor="middle"
              font-size="11"
              fill="currentColor"
              fill-opacity="0.45"
            >
              {monthNames[new Date(s.day).getMonth()]} {new Date(s.day).getDate()}
            </text>
          ) : null,
        )
      }
    </svg>
  </div>
</div>
