---
import { getAllCategories, getAllTags, getPosts, popularRangeLabels } from '../lib/content';
import type { PopularRange } from '../lib/content';
import { getSettings } from '../lib/settings';
import { categoryUrl, tagUrl } from '../lib/permalink';
import PostCard from './PostCard.astro';
import Ads from './Ads.astro';
import { ensureCsrfCookie, getCsrfSecret } from '../lib/csrf';

interface Props {
  showPopular?: boolean;
  showCategories?: boolean;
  showTags?: boolean;
  showNewsletter?: boolean;
  excludePostId?: number;
}

const {
  showPopular = true,
  showCategories = true,
  showTags = true,
  showNewsletter = true,
  excludePostId,
} = Astro.props;

const settings = await getSettings();
const csrfToken = ensureCsrfCookie(Astro.cookies, getCsrfSecret());

/* Periode populer diatur dari panel: Admin → Pengaturan → Tampilan & Konten */
const validRanges: PopularRange[] = ['all', 'day', 'week', 'month'];
const popularRange: PopularRange = validRanges.includes(
  settings.sidebarPopularRange as PopularRange,
)
  ? (settings.sidebarPopularRange as PopularRange)
  : 'all';

const [categories, tags, popular] = await Promise.all([
  showCategories ? getAllCategories() : Promise.resolve([]),
  showTags ? getAllTags() : Promise.resolve([]),
  showPopular
    ? getPosts({
        perPage: 6,
        sort: 'populer',
        popularRange,
        limit: 6,
      }).then((r) => r.rows)
    : Promise.resolve([]),
]);

const popularList = popular.filter((p) => p.post.id !== excludePostId).slice(0, 5);
---

<aside class="space-y-6">
  <Ads placement="sidebar_top" />

  {
    showPopular && popularList.length > 0 && (
      <section class="card-modern p-5">
        <div class="mb-4 flex items-center justify-between gap-2 border-b border-ink-100 pb-3">
          <h2 class="title-underline inline-flex items-center gap-2 pb-2 text-base font-extrabold uppercase tracking-wide text-ink-900">
            <span class="h-2 w-2 rounded-full bg-coral-500" /> Populer
          </h2>
          {
            popularRange !== 'all' && (
              <span class="rounded-full bg-ink-100 px-2.5 py-1 text-[11px] font-bold text-ink-500">
                {popularRangeLabels[popularRange]}
              </span>
            )
          }
        </div>

        <div class="space-y-4">
          {popularList.map((p, i) => (
            <PostCard post={p.post} variant="compact" rank={i + 1} />
          ))}
        </div>
      </section>
    )
  }

  {
    showCategories && categories.length > 0 && (
      <section class="card-modern p-5">
        <h2 class="title-underline mb-4 inline-flex items-center gap-2 pb-2 text-base font-extrabold uppercase tracking-wide text-ink-900">
          <span class="h-2 w-2 rounded-full bg-night-900" /> Kategori
        </h2>
        <ul class="space-y-1">
          {categories.slice(0, 10).map((cat) => (
            <li>
              <a
                href={categoryUrl(cat.slug, settings)}
                class="flex items-center justify-between rounded-xl px-3 py-2 text-sm font-medium text-ink-700 transition hover:bg-mint-50 hover:text-mint-700"
              >
                <span>{cat.name}</span>
                <span class="rounded-full bg-ink-100 px-2 py-0.5 text-[11px] font-bold text-ink-500">
                  {cat.count}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    showTags && tags.length > 0 && (
      <section class="card-modern p-5">
        <h2 class="title-underline mb-4 inline-flex items-center gap-2 pb-2 text-base font-extrabold uppercase tracking-wide text-ink-900">
          <span class="h-2 w-2 rounded-full bg-brand-400" /> Tag Populer
        </h2>
        <div class="flex flex-wrap gap-2">
          {tags.slice(0, 20).map((tag) => (
            <a
              href={tagUrl(tag.slug, settings)}
              class="chip bg-brand-100 text-brand-800 transition hover:bg-brand-400 hover:text-brand-ink"
            >
              #{tag.name}
            </a>
          ))}
        </div>
      </section>
    )
  }

  {
    showNewsletter && (
      <section class="relative overflow-hidden rounded-3xl bg-splash-brand p-6 text-white shadow-pop">
        <div class="blob blob-sun -top-10 -right-6 h-32 w-32 opacity-40"></div>
        <div class="relative z-10">
          <span class="chip bg-white/20 text-white backdrop-blur">Newsletter</span>
          <h2 class="mt-3 font-display text-xl font-extrabold">Jangan Lewat Kabar Penting</h2>
          <p class="mt-2 text-sm leading-relaxed text-white/85">
            Ringkasan berita pilihan setiap pagi, langsung ke inbox kamu.
          </p>
          <form method="post" action="/api/subscribe" class="mt-4 space-y-2">
            <input type="hidden" name="_csrf" value={csrfToken} />
            <input
              type="email"
              name="email"
              required
              placeholder="alamat@email.com"
              class="w-full rounded-xl border border-white/25 bg-white/15 px-4 py-2.5 text-sm text-white outline-none placeholder:text-white/60 focus:border-white/60 focus:bg-white/25"
            />
            <button
              type="submit"
              class="w-full rounded-xl bg-brand-400 px-4 py-2.5 text-sm font-extrabold text-brand-ink transition hover:bg-brand-300"
            >
              Berlangganan Gratis →
            </button>
          </form>
        </div>
      </section>
    )
  }
  <Ads placement="sidebar_bottom" class="mt-6" />
</aside>
