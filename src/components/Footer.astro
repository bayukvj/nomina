---
import { getSettings, toBool } from '../lib/settings';
import { getMenu } from '../lib/content';
import Ads from './Ads.astro';

const settings = await getSettings();
const footerMenu = await getMenu('footer');
const legalMenu = await getMenu('legal');

const socials = [
  { label: 'Instagram', url: settings.socialInstagram },
  { label: 'TikTok', url: settings.socialTiktok },
  { label: 'YouTube', url: settings.socialYoutube },
  { label: 'X (Twitter)', url: settings.socialX },
  { label: 'LinkedIn', url: settings.socialLinkedin },
  { label: 'Telegram', url: settings.socialTelegram },
].filter((s) => s.url && !s.url.endsWith('/'));

const year = new Date().getFullYear();
const footerText = (settings.footerText || '© {year} {siteName}')
  .replace('{year}', String(year))
  .replace('{siteName}', settings.siteName);
---

<footer class="relative mt-20 overflow-hidden bg-night-900 text-night-fg">
  <div class="blob blob-brand -top-24 left-10 h-72 w-72 opacity-30"></div>
  <div class="blob blob-grape top-40 right-0 h-80 w-80 opacity-25"></div>
  <div class="blob blob-mint bottom-0 left-1/3 h-64 w-64 opacity-20"></div>

  <div class="container-site relative z-10 pt-12">
    <Ads placement="footer" format="fluid" />
  </div>

  <div class="container-site relative z-10 grid gap-10 py-16 md:grid-cols-4">
    <div>
      <div class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-400 text-lg font-black text-brand-ink">
          {settings.siteName.charAt(0)}
        </span>
        <span class="font-display text-xl font-extrabold text-white">{settings.siteName}</span>
      </div>
      <p class="mt-4 text-sm leading-relaxed text-night-fg-muted">{settings.siteDescription}</p>
      <p class="mt-3 text-xs font-semibold uppercase tracking-wider text-night-fg-muted">
        {new Date().toLocaleDateString('id-ID', {
          weekday: 'long',
          day: 'numeric',
          month: 'long',
          year: 'numeric',
        })}
      </p>
      {
        socials.length > 0 && (
          <div class="mt-5 flex flex-wrap gap-2">
            {socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                class="rounded-full border border-white/15 bg-white/5 px-3 py-1.5 text-xs font-semibold text-night-fg-muted transition hover:border-transparent hover:bg-brand-400 hover:text-brand-ink"
              >
                {s.label}
              </a>
            ))}
          </div>
        )
      }
    </div>

    <div>
      <h3 class="mb-4 flex items-center gap-2 text-sm font-extrabold uppercase tracking-wider text-white">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span> Navigasi
      </h3>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/" class="transition hover:text-white">Beranda</a></li>
        {
          (footerMenu?.items ?? []).map((item) => (
            <li>
              <a href={item.url} class="transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h3 class="mb-4 flex items-center gap-2 text-sm font-extrabold uppercase tracking-wider text-white">
        <span class="h-1.5 w-1.5 rounded-full bg-ink-500"></span> Informasi
      </h3>
      <ul class="space-y-2.5 text-sm">
        {
          (legalMenu?.items ?? []).map((item) => (
            <li>
              <a href={item.url} class="transition hover:text-white">
                {item.label}
              </a>
            </li>
          ))
        }
        <li><a href="/rss.xml" class="transition hover:text-white">RSS Feed</a></li>
        <li><a href="/sitemap.xml" class="transition hover:text-white">Peta Situs</a></li>
      </ul>
    </div>

    <div>
      <h3 class="mb-4 flex items-center gap-2 text-sm font-extrabold uppercase tracking-wider text-white">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span> Redaksi
      </h3>
      <ul class="space-y-2 text-sm text-night-fg-muted">
        {settings.siteAddress && <li>{settings.siteAddress}</li>}
        {settings.siteEmail && (
          <li>
            <a href={`mailto:${settings.siteEmail}`} class="transition hover:text-white">
              {settings.siteEmail}
            </a>
          </li>
        )}
        {settings.sitePhone && <li>{settings.sitePhone}</li>}
      </ul>
      <a
        href="/halaman/kontak"
        class="mt-5 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-2 text-xs font-bold text-white transition hover:bg-brand-400 hover:text-brand-ink"
      >
        Hubungi Kami
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>

  <div class="relative z-10 border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-2 py-5 text-xs text-night-fg-muted sm:flex-row">
      <p>{footerText}</p>
      {settings.footerCredit?.trim() && <p>{settings.footerCredit}</p>}
    </div>
  </div>
</footer>
