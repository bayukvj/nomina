---
import PublicLayout from '../layouts/PublicLayout.astro';
import PostCard from '../components/PostCard.astro';
import Sidebar from '../components/Sidebar.astro';
import Ads from '../components/Ads.astro';
import { getSettings } from '../lib/settings';
import { getPosts, getAllCategories } from '../lib/content';
import { categoryUrl, postUrl } from '../lib/permalink';
import { formatDate } from '../lib/utils';

const settings = await getSettings();
const perPage = Number(settings.postsPerPage) || 10;
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1) || 1);

const [latest, featured, categories] = await Promise.all([
  getPosts({ page, perPage, sort: 'terbaru' }),
  getPosts({ perPage: 1, featured: true, sort: 'terbaru' }),
  getAllCategories(),
]);

const featuredRow = featured.rows[0];
const featuredUrl = featuredRow
  ? postUrl(
      {
        slug: featuredRow.post.slug,
        id: featuredRow.post.id,
        title: featuredRow.post.title,
        categorySlug: featuredRow.category?.slug,
        publishedAt: featuredRow.post.publishedAt,
        createdAt: featuredRow.post.createdAt,
      },
      settings,
    )
  : '';

const secondary = latest.rows.slice(0, 2);
const rest = latest.rows.slice(2);
const videoPosts = await getPosts({ perPage: 4, type: 'video' });

const categorySections = await Promise.all(
  categories.slice(0, 3).map(async (cat) => ({
    category: cat,
    posts: (await getPosts({ categorySlug: cat.slug, perPage: 3 })).rows,
  })),
);
---

<PublicLayout>


  <!-- ===== HERO ===== -->
  <section class="relative overflow-hidden bg-rainbow-soft">
    <div class="blob blob-brand -top-32 -left-20 h-96 w-96 animate-float"></div>
    <div class="blob blob-grape top-10 right-0 h-80 w-80 animate-float-slow"></div>
    <div class="blob blob-mint -bottom-24 left-1/3 h-72 w-72"></div>

    <div class="container-site relative z-10 py-10 sm:py-14">
      {
        featuredRow && (
          <div class="grid items-center gap-8 lg:grid-cols-[1.1fr_1fr]">
            <div class="animate-pop">
              <span class="chip bg-brand-400 text-brand-ink shadow-soft">
                <span class="h-1.5 w-1.5 rounded-full bg-brand-400" />
                {featuredRow.category?.name ?? 'Sorotan'}
              </span>

              <h1 class="mt-4 font-display text-3xl font-extrabold leading-[1.1] tracking-tight text-ink-900 sm:text-4xl lg:text-5xl">
                {featuredRow.post.title}
              </h1>

              {featuredRow.post.excerpt && (
                <p class="mt-4 max-w-xl text-base leading-relaxed text-ink-600 sm:text-lg">
                  {featuredRow.post.excerpt}
                </p>
              )}

              <div class="mt-6 flex flex-wrap items-center gap-3">
                <a
                  href={featuredUrl}
                  class="inline-flex items-center gap-2 rounded-full bg-brand-400 px-6 py-3 text-sm font-bold text-brand-ink shadow-pop transition hover:-translate-y-0.5 hover:opacity-90"
                >
                  Baca Selengkapnya
                  <span aria-hidden="true">→</span>
                </a>
                {featuredRow.category && (
                  <a
                    href={categoryUrl(featuredRow.category.slug, settings)}
                    class="inline-flex items-center gap-2 rounded-full border border-ink-200 bg-surface/80 px-5 py-3 text-sm font-bold text-ink-700 backdrop-blur transition hover:border-brand-400 hover:text-brand-700"
                  >
                    {featuredRow.category.name}
                  </a>
                )}
              </div>

              <div class="mt-6 flex flex-wrap items-center gap-3 text-xs text-ink-500">
                {featuredRow.author && (
                  <span class="flex items-center gap-2 font-semibold text-ink-700">
                    <span class="flex h-7 w-7 items-center justify-center overflow-hidden rounded-full bg-brand-400 text-xs font-bold text-brand-ink">
                      {featuredRow.author.avatar ? (
                        <img src={featuredRow.author.avatar} alt={featuredRow.author.name} class="h-full w-full object-cover" />
                      ) : (
                        featuredRow.author.name.charAt(0)
                      )}
                    </span>
                    {featuredRow.author.name}
                  </span>
                )}
                <span class="h-1 w-1 rounded-full bg-ink-300" />
                <span>
                  {formatDate(featuredRow.post.publishedAt ?? featuredRow.post.createdAt, 'short')}
                </span>
              </div>
            </div>

            <div class="animate-pop [animation-delay:120ms]">
              <PostCard post={featuredRow.post} variant="featured" />
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- ===== IKLAN BAWAH HERO ===== -->
  <div class="container-site">
    <Ads placement="below_hero" format="fluid" class="mt-6" />
  </div>

  <div class="container-site grid gap-10 py-10 lg:grid-cols-[1fr_320px]">
    <div class="min-w-0">
      {
        secondary.length > 0 && (
          <section class="mb-12 grid gap-6 sm:grid-cols-2">
            {secondary.map((p) => (
              <PostCard post={p.post} />
            ))}
          </section>
        )
      }

      <section class="min-w-0">
        <h2 class="title-underline mb-6 inline-flex items-center gap-2 pb-2 text-xl font-extrabold uppercase tracking-wide text-ink-900">
          <span class="h-2 w-2 rounded-full bg-brand-400" /> Terbaru
        </h2>
          <div class="grid gap-6 sm:grid-cols-2">
            {rest.map((p, i) => (
              <>
                <PostCard post={p.post} />
                {(i === 1 || (rest.length <= 2 && i === rest.length - 1)) && (
                  <Ads placement="between_posts" class="sm:col-span-2" />
                )}
              </>
            ))}
          </div>

        {
          latest.totalPages > 1 && (
            <nav class="mt-10 flex flex-wrap justify-center gap-2">
              {Array.from({ length: latest.totalPages }).map((_, i) => (
                <a
                  href={`/?page=${i + 1}`}
                  class={`rounded-full border px-4 py-2 text-sm font-bold transition ${
                    i + 1 === page
                      ? 'border-transparent bg-brand-400 text-brand-ink shadow-pop'
                      : 'border-ink-200 bg-surface text-ink-700 hover:border-brand-400 hover:text-brand-700'
                  }`}
                >
                  {i + 1}
                </a>
              ))}
            </nav>
          )
        }
      </section>

      {
        videoPosts.rows.length > 0 && (
          <section class="mt-16">
            <h2 class="title-underline mb-6 inline-flex items-center gap-2 pb-2 text-xl font-extrabold uppercase tracking-wide text-ink-900">
              <span class="h-2 w-2 rounded-full bg-night-900" /> Video
            </h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
              {videoPosts.rows.map((p) => (
                <PostCard post={p.post} showExcerpt={false} />
              ))}
            </div>
          </section>
        )
      }

      {
        categorySections.map(({ category: cat, posts }) => (
          <section class="mt-16">
            <h2 class="mb-6 flex items-center justify-between gap-3 border-b border-ink-200 pb-3 text-ink-900">
              <span class="title-underline inline-flex items-center gap-2 pb-2 text-xl font-extrabold uppercase tracking-wide text-ink-900">
                <span class="h-2 w-2 rounded-full bg-brand-400" /> {cat.name}
              </span>
              <a
                href={categoryUrl(cat.slug, settings)}
                class="shrink-0 text-sm font-bold text-brand-600 transition hover:text-brand-300"
              >
                Lihat semua →
              </a>
            </h2>
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
              {posts.map((p) => (
                <PostCard post={p.post} />
              ))}
            </div>
          </section>
        ))
      }
    </div>

    <Sidebar />
  </div>
</PublicLayout>
