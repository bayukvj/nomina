---
import PublicLayout from '../layouts/PublicLayout.astro';
---

<PublicLayout title="Halaman tidak ditemukan" noindex>
  <section class="relative overflow-hidden bg-rainbow-soft">
    <div class="blob blob-brand -top-24 -left-20 h-96 w-96 animate-float"></div>
    <div class="blob blob-grape top-10 right-0 h-80 w-80 animate-float-slow"></div>
    <div class="blob blob-mint -bottom-24 left-1/3 h-72 w-72"></div>

    <div class="container-site relative z-10 flex min-h-[65vh] flex-col items-center justify-center py-20 text-center">
      <p class="font-display text-8xl font-extrabold text-rainbow sm:text-9xl">404</p>
      <h1 class="mt-4 font-display text-3xl font-extrabold tracking-tight text-ink-900 sm:text-4xl">
        Halaman tidak ditemukan
      </h1>
      <p class="mt-3 max-w-md text-ink-600">
        Maaf, halaman yang kamu cari sudah dipindahkan atau memang tidak pernah ada. Yuk kembali ke
        beranda dan mulai menjelajah.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="rounded-full bg-brand-400 px-6 py-3 text-sm font-extrabold text-brand-ink shadow-pop transition hover:-translate-y-0.5 hover:opacity-90"
        >
          ← Kembali ke Beranda
        </a>
        <a
          href="/cari"
          class="rounded-full border border-ink-200 bg-surface/80 px-6 py-3 text-sm font-bold text-ink-700 backdrop-blur transition hover:border-brand-400 hover:text-brand-700"
        >
          Cari Artikel
        </a>
      </div>
    </div>
  </section>
</PublicLayout>
