---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/admin/Icon.astro';
import { getPosts, getAllCategories } from '../../../lib/content';
import { deletePost, bulkAction } from '../../../lib/admin/save';
import { formatDate, formatNumber } from '../../../lib/utils';
import { getSettings } from '../../../lib/settings';
import { postUrl } from '../../../lib/permalink';
import { validateCsrfForm, ensureCsrfCookie, getCsrfSecret } from '../../../lib/csrf';

const settings = await getSettings();
const user = Astro.locals.user;
const csrfToken = ensureCsrfCookie(Astro.cookies, getCsrfSecret());
let message = '';
let messageType = 'success';

if (Astro.request.method === 'POST') {
  const form = await validateCsrfForm(Astro.cookies, Astro.request, getCsrfSecret()).catch(() => null);
  if (!form) {
    return new Response('Forbidden', { status: 403 });
  }
  const action = String(form.get('_action') ?? '');

  if (action === 'delete') {
    await deletePost(Number(form.get('id')));
    message = 'Post berhasil dihapus.';
  } else if (action === 'bulk') {
    const ids = form.getAll('ids').map((v) => Number(v)).filter(Boolean);
    await bulkAction(String(form.get('bulk_action') ?? ''), ids);
    message = `${ids.length} post diproses.`;
  }
}

const deleteId = Astro.url.searchParams.get('delete');
if (deleteId) {
  await deletePost(Number(deleteId));
  return Astro.redirect('/admin/posts?msg=Post+berhasil+dihapus');
}

const q = Astro.url.searchParams.get('q') ?? '';
const status = Astro.url.searchParams.get('status') ?? '';
const category = Astro.url.searchParams.get('category') ?? '';
const type = Astro.url.searchParams.get('type') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page') ?? 1) || 1);

const result = await getPosts({
  page,
  perPage: 15,
  includeAll: true,
  status: (status || undefined) as never,
  categorySlug: category || undefined,
  type: type || undefined,
  search: q || undefined,
  sort: 'terbaru',
});

const categories = await getAllCategories();
const msg = Astro.url.searchParams.get('msg');
if (msg) {
  message = msg;
  messageType = Astro.url.searchParams.get('type') === 'error' ? 'error' : 'success';
}
---

<AdminLayout title="Post" active="posts" wide>
  {
    message && (
      <div
        class={`mb-5 rounded-lg border px-4 py-3 text-sm font-medium ${
          messageType === 'error'
            ? 'border-brand-200 bg-brand-50 text-brand-700'
            : 'border-emerald-200 bg-emerald-50 text-emerald-700'
        }`}
      >
        {message}
      </div>
    )
  }

  <div class="mb-5 flex flex-wrap items-center gap-3">
    <a
      href="/admin/posts/new"
      class="inline-flex items-center gap-2 rounded-lg bg-brand-400 px-4 py-2.5 text-sm font-bold text-brand-ink hover:bg-brand-300"
    >
      <Icon name="plus" class="h-4 w-4" /> Tulis Post
    </a>

    <form method="get" class="flex flex-wrap items-center gap-2">
      <input
        type="search"
        name="q"
        value={q}
        placeholder="Cari judul/isi…"
        class="w-56 rounded-lg border border-ink-200 px-3 py-2 text-sm outline-none focus:border-brand-500"
      />
      <select name="status" class="rounded-lg border border-ink-200 px-3 py-2 text-sm">
        <option value="">Semua status</option>
        <option value="published" selected={status === 'published'}>Published</option>
        <option value="draft" selected={status === 'draft'}>Draft</option>
        <option value="scheduled" selected={status === 'scheduled'}>Scheduled</option>
        <option value="archived" selected={status === 'archived'}>Archived</option>
      </select>
      <select name="category" class="rounded-lg border border-ink-200 px-3 py-2 text-sm">
        <option value="">Semua kategori</option>
        {categories.map((c) => <option value={c.slug} selected={category === c.slug}>{c.name}</option>)}
      </select>
      <select name="type" class="rounded-lg border border-ink-200 px-3 py-2 text-sm">
        <option value="">Semua tipe</option>
        <option value="article" selected={type === 'article'}>Artikel</option>
        <option value="news" selected={type === 'news'}>Berita</option>
        <option value="video" selected={type === 'video'}>Video</option>
        <option value="photo" selected={type === 'photo'}>Foto</option>
        <option value="gallery" selected={type === 'gallery'}>Galeri</option>
      </select>
      <button type="submit" class="rounded-lg border border-ink-200 px-4 py-2 text-sm font-semibold text-ink-700 hover:border-brand-500">
        Filter
      </button>
      {(q || status || category || type) && (
        <a href="/admin/posts" class="text-sm text-ink-500 hover:text-brand-700">Reset</a>
      )}
    </form>
  </div>

  <form method="post" class="rounded-xl border border-ink-200 bg-surface">
    <input type="hidden" name="_csrf" value={csrfToken} />
    <div class="flex flex-wrap items-center gap-2 border-b border-ink-200 px-4 py-3">
      <select name="bulk_action" class="rounded-lg border border-ink-200 px-3 py-1.5 text-sm">
        <option value="">Aksi massal…</option>
        <option value="publish">Terbitkan</option>
        <option value="draft">Jadikan draft</option>
        <option value="feature">Jadikan unggulan</option>
        <option value="unfeature">Hapus unggulan</option>
        <option value="delete">Hapus</option>
      </select>
      <button type="submit" class="rounded-lg bg-night-800 px-3 py-1.5 text-sm font-semibold text-white hover:bg-ink-700">
        Jalankan
      </button>
      <span class="ml-auto text-xs text-ink-500">{result.total} post</span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full min-w-[900px] text-sm">
        <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="w-10 px-4 py-3"><input type="checkbox" onclick="document.querySelectorAll('input[name=ids]').forEach(c=>c.checked=this.checked)" /></th>
            <th class="px-4 py-3">Judul</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Kategori</th>
            <th class="px-4 py-3">Penulis</th>
            <th class="px-4 py-3">Tipe</th>
            <th class="px-4 py-3">Tanggal</th>
            <th class="px-4 py-3 text-right">Views</th>
            <th class="px-4 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          {
            result.rows.length === 0 && (
              <tr>
                <td colspan="9" class="px-4 py-14 text-center text-ink-500">
                  Tidak ada post yang cocok.
                </td>
              </tr>
            )
          }
          {
            result.rows.map((r) => (
              <tr class="hover:bg-ink-50/60">
                <td class="px-4 py-3">
                  <input type="checkbox" name="ids" value={r.post.id} class="h-4 w-4 rounded border-ink-300" />
                </td>
                <td class="px-4 py-3">
                  <div class="flex items-center gap-3">
                    {r.cover?.url ? (
                      <img src={r.cover.url} alt="" class="h-10 w-16 shrink-0 rounded object-cover" />
                    ) : (
                      <span class="flex h-10 w-16 shrink-0 items-center justify-center rounded bg-ink-100 text-xs text-ink-400">
                        —
                      </span>
                    )}
                    <div class="min-w-0">
                      <a
                        href={`/admin/posts/${r.post.id}`}
                        class="line-clamp-1 font-semibold text-ink-900 hover:text-brand-700"
                      >
                        {r.post.title}
                      </a>
                      <p class="text-xs text-ink-400">/{r.post.slug}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <span
                    class={`rounded px-2 py-0.5 text-xs font-semibold ${
                      r.post.status === 'published'
                        ? 'bg-emerald-50 text-emerald-700'
                        : r.post.status === 'draft'
                          ? 'bg-ink-100 text-ink-600'
                          : r.post.status === 'scheduled'
                            ? 'bg-amber-50 text-amber-700'
                            : 'bg-ink-100 text-ink-500'
                    }`}
                  >
                    {r.post.status}
                  </span>
                  {r.post.isFeatured && (
                    <span class="ml-1 rounded bg-brand-50 px-2 py-0.5 text-xs font-semibold text-brand-700">
                      ★
                    </span>
                  )}
                </td>
                <td class="px-4 py-3 text-ink-600">{r.category?.name ?? '—'}</td>
                <td class="px-4 py-3 text-ink-600">{r.author?.name ?? '—'}</td>
                <td class="px-4 py-3 text-ink-600 capitalize">{r.post.type}</td>
                <td class="px-4 py-3 text-ink-600">{formatDate(r.post.publishedAt ?? r.post.createdAt, 'short')}</td>
                <td class="px-4 py-3 text-right text-ink-600">{formatNumber(r.post.views)}</td>
                <td class="px-4 py-3">
                  <div class="flex items-center justify-end gap-1">
                    <a
                      href={postUrl(
                        {
                          slug: r.post.slug,
                          id: r.post.id,
                          categorySlug: r.category?.slug,
                          publishedAt: r.post.publishedAt,
                          createdAt: r.post.createdAt,
                        },
                        settings,
                      )}
                      target="_blank"
                      class="rounded p-1.5 text-ink-400 hover:text-brand-600"
                      title="Lihat"
                    >
                      <Icon name="eye" class="h-4 w-4" />
                    </a>
                    <a
                      href={`/admin/posts/${r.post.id}`}
                      class="rounded p-1.5 text-ink-400 hover:text-brand-600"
                      title="Edit"
                    >
                      <Icon name="edit" class="h-4 w-4" />
                    </a>
                    <a
                      href={`/admin/posts?delete=${r.post.id}`}
                      data-confirm="Hapus post ini? Tindakan tidak dapat dibatalkan."
                      class="rounded p-1.5 text-ink-400 hover:text-brand-600"
                      title="Hapus"
                    >
                      <Icon name="trash" class="h-4 w-4" />
                    </a>
                  </div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </form>

  {
    result.totalPages > 1 && (
      <nav class="mt-6 flex justify-center gap-1">
        {Array.from({ length: result.totalPages }).map((_, i) => (
          <a
            href={`?${new URLSearchParams({
              ...(q ? { q } : {}),
              ...(status ? { status } : {}),
              ...(category ? { category } : {}),
              ...(type ? { type } : {}),
              page: String(i + 1),
            }).toString()}`}
            class={`rounded-lg border px-3.5 py-2 text-sm font-semibold ${
              i + 1 === page
                ? 'border-brand-400 bg-brand-400 text-brand-ink'
                : 'border-ink-200 text-ink-700 hover:border-brand-500'
            }`}
          >
            {i + 1}
          </a>
        ))}
      </nav>
    )
  }
</AdminLayout>
