---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/admin/Icon.astro';
import { getAllTags } from '../../../lib/content';
import { saveTag, deleteTag } from '../../../lib/admin/save';
import { validateCsrfForm, ensureCsrfCookie, getCsrfSecret } from '../../../lib/csrf';

const csrfToken = ensureCsrfCookie(Astro.cookies, getCsrfSecret());
let message = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await validateCsrfForm(Astro.cookies, Astro.request, getCsrfSecret()).catch(() => null);
  if (!form) {
    error = 'Permintaan tidak valid (CSRF).';
  } else {
    const action = String(form.get('_action') ?? '');

    if (action === 'create') {
      const result = await saveTag(String(form.get('name') ?? ''));
      if (result.error) error = result.error;
      else message = 'Tag berhasil ditambahkan.';
    } else if (action === 'update') {
      const result = await saveTag(String(form.get('name') ?? ''), Number(form.get('id')));
      if (result.error) error = result.error;
      else message = 'Tag berhasil diperbarui.';
    }
  }
}

const deleteId = Astro.url.searchParams.get('delete');
if (deleteId) {
  await deleteTag(Number(deleteId));
  return Astro.redirect('/admin/tags?msg=Tag+berhasil+dihapus');
}

const tags = await getAllTags();
const msg = Astro.url.searchParams.get('msg');
if (msg) message = msg;
---

<AdminLayout title="Tag" active="tags">
  {
    (message || error) && (
      <div
        class={`mb-5 rounded-lg border px-4 py-3 text-sm font-medium ${
          error ? 'border-brand-200 bg-brand-50 text-brand-700' : 'border-emerald-200 bg-emerald-50 text-emerald-700'
        }`}
      >
        {error || message}
      </div>
    )
  }

  <div class="grid gap-6 lg:grid-cols-3">
    <section class="rounded-xl border border-ink-200 bg-surface p-5">
      <h2 class="mb-4 text-base font-black text-ink-900">Tambah Tag Baru</h2>
      <form method="post" class="space-y-3">
        <input type="hidden" name="_action" value="create" />
        <input type="hidden" name="_csrf" value={csrfToken} />
        <input
          type="text"
          name="name"
          required
          placeholder="Nama tag"
          class="w-full rounded-lg border border-ink-200 px-3 py-2 text-sm outline-none focus:border-brand-500"
        />
        <button type="submit" class="rounded-lg bg-brand-400 px-4 py-2 text-sm font-bold text-brand-ink hover:bg-brand-300">
          Tambah Tag
        </button>
      </form>
    </section>

    <section class="overflow-hidden rounded-xl border border-ink-200 bg-surface lg:col-span-2">
      <table class="w-full text-sm">
        <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
          <tr>
            <th class="px-4 py-3">Tag</th>
            <th class="px-4 py-3">Slug</th>
            <th class="px-4 py-3 text-right">Dipakai</th>
            <th class="px-4 py-3 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-ink-100">
          {
            tags.length === 0 && (
              <tr>
                <td colspan="4" class="px-4 py-14 text-center text-ink-500">Belum ada tag.</td>
              </tr>
            )
          }
          {
            tags.map((t) => (
              <tr class="hover:bg-ink-50/60">
                <td class="px-4 py-3">
                <form method="post" class="flex items-center gap-2">
                  <input type="hidden" name="_action" value="update" />
                  <input type="hidden" name="_csrf" value={csrfToken} />
                    <input type="hidden" name="id" value={t.id} />
                    <input
                      type="text"
                      name="name"
                      value={t.name}
                      class="w-48 rounded-lg border border-ink-200 px-2.5 py-1.5 text-sm outline-none focus:border-brand-500"
                    />
                    <button
                      type="submit"
                      class="rounded-lg border border-ink-200 px-2.5 py-1.5 text-xs font-semibold text-ink-600 hover:border-brand-500 hover:text-brand-700"
                    >
                      Simpan
                    </button>
                  </form>
                </td>
                <td class="px-4 py-3 text-ink-500">/{t.slug}</td>
                <td class="px-4 py-3 text-right text-ink-600">{t.count}</td>
                <td class="px-4 py-3 text-right">
                  <a
                    href={`/admin/tags?delete=${t.id}`}
                    data-confirm="Hapus tag ini?"
                    class="inline-block rounded p-1.5 text-ink-400 hover:text-brand-600"
                  >
                    <Icon name="trash" class="h-4 w-4" />
                  </a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </section>
  </div>
</AdminLayout>
