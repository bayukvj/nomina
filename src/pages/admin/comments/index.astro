---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/admin/Icon.astro';
import { db } from '../../../db';
import { comments, posts } from '../../../db/schema';
import { desc, eq } from 'drizzle-orm';
import { setCommentStatus, deleteComment } from '../../../lib/admin/save';
import { timeAgo } from '../../../lib/utils';
import { validateCsrfForm, ensureCsrfCookie, getCsrfSecret } from '../../../lib/csrf';

const csrfToken = ensureCsrfCookie(Astro.cookies, getCsrfSecret());
const status = Astro.url.searchParams.get('status') ?? 'pending';

const rows = await db
  .select({ comment: comments, post: posts })
  .from(comments)
  .innerJoin(posts, eq(comments.postId, posts.id))
  .where(status === 'all' ? undefined : eq(comments.status, status as never))
  .orderBy(desc(comments.createdAt))
  .limit(100);

if (Astro.request.method === 'POST') {
  const form = await validateCsrfForm(Astro.cookies, Astro.request, getCsrfSecret()).catch(() => null);
  if (!form) {
    return new Response('Forbidden', { status: 403 });
  }
  const action = String(form.get('_action') ?? '');
  const id = Number(form.get('id'));

  if (action === 'set') {
    await setCommentStatus(id, String(form.get('status')) as never);
  } else if (action === 'delete') {
    await deleteComment(id);
  }
  return Astro.redirect(`/admin/comments?status=${status}`);
}

const counts = {
  pending: rows.filter((r) => r.comment.status === 'pending').length,
};
---

<AdminLayout title="Komentar" active="comments">
  <div class="mb-5 flex flex-wrap items-center gap-2">
    {
      ['pending', 'approved', 'spam', 'trash', 'all'].map((s) => (
        <a
          href={`/admin/comments?status=${s}`}
          class={`rounded-lg border px-4 py-2 text-sm font-semibold ${
            status === s
              ? 'border-brand-400 bg-brand-400 text-brand-ink'
              : 'border-ink-200 bg-surface text-ink-700 hover:border-brand-400'
          }`}
        >
          {s === 'all' ? 'Semua' : s.charAt(0).toUpperCase() + s.slice(1)}
        </a>
      ))
    }
  </div>

  <div class="space-y-3">
    {
      rows.length === 0 && (
        <div class="rounded-xl border border-dashed border-ink-300 bg-surface p-16 text-center text-ink-500">
          Tidak ada komentar pada status ini.
        </div>
      )
    }
    {
      rows.map((r) => (
        <div class="rounded-xl border border-ink-200 bg-surface p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-700">
                  {r.comment.name.charAt(0)}
                </span>
                <div>
                  <p class="text-sm font-bold text-ink-900">{r.comment.name}</p>
                  <p class="text-xs text-ink-500">
                    {r.comment.email} • {timeAgo(r.comment.createdAt)}
                  </p>
                </div>
                <span
                  class={`rounded px-2 py-0.5 text-xs font-semibold ${
                    r.comment.status === 'approved'
                      ? 'bg-emerald-50 text-emerald-700'
                      : r.comment.status === 'pending'
                        ? 'bg-amber-50 text-amber-700'
                        : 'bg-ink-100 text-ink-500'
                  }`}
                >
                  {r.comment.status}
                </span>
              </div>
              <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-ink-700">{r.comment.body}</p>
              <p class="mt-2 text-xs text-ink-400">
                pada “{r.post.title}”
              </p>
            </div>

            <div class="flex shrink-0 flex-wrap gap-1.5">
              {r.comment.status !== 'approved' && (
              <form method="post">
                   <input type="hidden" name="_action" value="set" />
                   <input type="hidden" name="_csrf" value={csrfToken} />
                   <input type="hidden" name="id" value={r.comment.id} />
                   <input type="hidden" name="status" value="approved" />
                  <button
                    type="submit"
                    class="rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-emerald-700"
                  >
                    Setujui
                  </button>
                </form>
              )}
              {r.comment.status !== 'spam' && (
                <form method="post">
                   <input type="hidden" name="_action" value="set" />
                   <input type="hidden" name="_csrf" value={csrfToken} />
                   <input type="hidden" name="id" value={r.comment.id} />
                   <input type="hidden" name="status" value="spam" />
                  <button
                    type="submit"
                    class="rounded-lg border border-ink-200 px-3 py-1.5 text-xs font-semibold text-ink-700 hover:border-brand-500"
                  >
                    Spam
                  </button>
                </form>
              )}
              <form method="post">
                   <input type="hidden" name="_action" value="delete" />
                   <input type="hidden" name="_csrf" value={csrfToken} />
                   <input type="hidden" name="id" value={r.comment.id} />
                <button
                  type="submit"
                  class="rounded-lg border border-ink-200 p-1.5 text-ink-400 hover:border-brand-600"
                  title="Hapus"
                >
                  <Icon name="trash" class="h-4 w-4" />
                </button>
              </form>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</AdminLayout>
