---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/admin/Icon.astro';
import { getAllAds, getAdStats, placementLabels, placementHints, adTypeLabels } from '../../../lib/ads';
import { deleteAd } from '../../../lib/admin/save';
import type { AdPlacement } from '../../../lib/ads';
import { formatNumber } from '../../../lib/utils';

const deleteId = Astro.url.searchParams.get('delete');
if (deleteId) {
  await deleteAd(Number(deleteId));
  return Astro.redirect('/admin/ads?msg=Iklan+berhasil+dihapus');
}

const stats = await getAdStats();
const ads = await getAllAds();

const statusBadge: Record<string, string> = {
  active: 'bg-mint-100 text-mint-700',
  paused: 'bg-ink-100 text-ink-600',
  scheduled: 'bg-sun-100 text-sun-700',
};
---

<AdminLayout title="Iklan" active="ads" wide>
  <div class="mb-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    <div class="card-modern p-5">
      <p class="text-xs font-extrabold uppercase tracking-wider text-ink-500">Total Iklan</p>
      <p class="mt-2 font-display text-3xl font-extrabold text-ink-900">{stats.total}</p>
    </div>
    <div class="card-modern p-5">
      <p class="text-xs font-extrabold uppercase tracking-wider text-ink-500">Aktif</p>
      <p class="mt-2 font-display text-3xl font-extrabold text-ink-900">{stats.active}</p>
    </div>
    <div class="card-modern p-5">
      <p class="text-xs font-extrabold uppercase tracking-wider text-ink-500">Impresi</p>
      <p class="mt-2 font-display text-3xl font-extrabold text-ink-900">
        {formatNumber(stats.impressions)}
      </p>
    </div>
    <div class="card-modern p-5">
      <p class="text-xs font-extrabold uppercase tracking-wider text-ink-500">Klik / CTR</p>
      <p class="mt-2 font-display text-3xl font-extrabold text-ink-900">
        {formatNumber(stats.clicks)}
        <span class="text-sm font-bold text-ink-500">({stats.ctr}%)</span>
      </p>
    </div>
  </div>

  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <p class="text-sm text-ink-500">
      Kelola iklan: banner gambar, kode custom (HTML/JS), atau Google AdSense beserta penempatannya.
    </p>
    <a
      href="/admin/ads/new"
      class="inline-flex items-center gap-2 rounded-lg bg-brand-400 px-4 py-2.5 text-sm font-extrabold text-brand-ink transition hover:opacity-90"
    >
      <Icon name="plus" class="h-4 w-4" /> Tambah Iklan
    </a>
  </div>

  <div class="overflow-hidden rounded-xl border border-ink-200 bg-surface">
    <table class="w-full text-sm">
      <thead class="bg-ink-50 text-left text-xs uppercase tracking-wider text-ink-500">
        <tr>
          <th class="px-4 py-3">Iklan</th>
          <th class="px-4 py-3">Jenis</th>
          <th class="px-4 py-3">Penempatan</th>
          <th class="px-4 py-3">Target</th>
          <th class="px-4 py-3">Status</th>
          <th class="px-4 py-3 text-right">Impresi</th>
          <th class="px-4 py-3 text-right">Klik</th>
          <th class="px-4 py-3 text-right">Aksi</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-ink-100">
        {
          ads.length === 0 && (
            <tr>
              <td colspan="8" class="px-4 py-14 text-center text-ink-500">
                Belum ada iklan.{" "}
                <a href="/admin/ads/new" class="font-bold text-brand-600">
                  Tambah iklan pertama
                </a>
              </td>
            </tr>
          )
        }
        {
          ads.map((row) => (
            <tr class="hover:bg-ink-50/60">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  {row.mediaUrl ? (
                    <img
                      src={row.mediaUrl}
                      alt={row.ad.name}
                      class="h-10 w-16 shrink-0 rounded object-cover"
                    />
                  ) : (
                    <span class="flex h-10 w-16 shrink-0 items-center justify-center rounded bg-ink-100 text-[10px] text-ink-500">
                      {row.ad.type === 'adsense' ? 'AdSense' : 'Kode'}
                    </span>
                  )}
                  <div class="min-w-0">
                    <a
                      href={`/admin/ads/${row.ad.id}`}
                      class="line-clamp-1 font-semibold text-ink-900 hover:text-brand-700"
                    >
                      {row.ad.name}
                    </a>
                    {row.ad.linkUrl && (
                      <p class="truncate text-xs text-ink-400">{row.ad.linkUrl}</p>
                    )}
                  </div>
                </div>
              </td>
              <td class="px-4 py-3">
                <span class="rounded bg-ink-100 px-2 py-0.5 text-xs font-semibold text-ink-700">
                  {adTypeLabels[row.ad.type] ?? row.ad.type}
                </span>
              </td>
              <td class="px-4 py-3 text-ink-600">{placementLabels[row.ad.placement] ?? row.ad.placement}</td>
              <td class="px-4 py-3 text-xs text-ink-500">
                {row.categoryNames?.length ? row.categoryNames.join(', ') : 'Semua kategori'}
              </td>
              <td class="px-4 py-3">
                <span
                  class={`rounded px-2 py-0.5 text-xs font-semibold ${
                    statusBadge[row.ad.status] ?? 'bg-ink-100 text-ink-600'
                  }`}
                >
                  {row.ad.status}
                </span>
              </td>
              <td class="px-4 py-3 text-right text-ink-600">{formatNumber(row.ad.impressions)}</td>
              <td class="px-4 py-3 text-right text-ink-600">{formatNumber(row.ad.clicks)}</td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-1">
                  <a
                    href={`/admin/ads/${row.ad.id}`}
                    class="rounded p-1.5 text-ink-400 hover:text-brand-600"
                    title="Edit"
                  >
                    <Icon name="edit" class="h-4 w-4" />
                  </a>
                  <a
                    href={`/admin/ads?delete=${row.ad.id}`}
                    data-confirm="Hapus iklan ini?"
                    class="rounded p-1.5 text-ink-400 hover:text-brand-600"
                    title="Hapus"
                  >
                    <Icon name="trash" class="h-4 w-4" />
                  </a>
                </div>
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <div class="mt-5 rounded-xl border border-ink-200 bg-surface p-5">
    <h2 class="mb-3 text-base font-extrabold text-ink-900">Penempatan Iklan yang Direkomendasikan</h2>
    <div class="grid gap-3 md:grid-cols-2">
      {
        Object.entries(placementLabels).map(([key, label]) => (
          <div class="rounded-xl border border-ink-100 bg-ink-50 p-3">
            <p class="text-sm font-bold text-ink-800">{label}</p>
            <p class="mt-1 text-xs leading-relaxed text-ink-600">{placementHints[key as AdPlacement]}</p>
          </div>
        ))
      }
    </div>
  </div>
</AdminLayout>
